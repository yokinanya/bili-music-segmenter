# 百炼：填写与 API key 对应的 HTTPS 接入地址，无通用默认地址
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# S3 兼容存储：私有 Bucket，授予指定前缀下的上传、读取和删除权限
# Endpoint 必须可由云端模型访问；可省略协议（默认 https://），如 s3.us-east-1.amazonaws.com
# 非 TLS 服务需显式填写 http://，如 http://minio.example.com:9000
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_ENDPOINT=
S3_BUCKET=
# 填写存储服务要求的 region，如 us-east-1；R2 通常为 auto
S3_REGION=

# 可选：临时音频对象前缀（留空表示桶根目录）
S3_PREFIX=music-agent
# path 适用于 MinIO 等；可选 virtual（AWS 常用）、auto
S3_ADDRESSING_STYLE=path
# 可选：自定义本程序请求 S3 时的 User-Agent；留空使用 SDK 默认值
S3_USER_AGENT=

# 可选：后端处理参数，未设置时使用 CLI 默认值；CLI 显式参数优先
# 所有 CLI 可选参数均可用 MUSIC_AGENT_ + 大写下划线参数名覆盖
# 分块扫描并发数，默认 3；设置为 1 使用串行
# MUSIC_AGENT_SCAN_CONCURRENCY=3
# JSON 解析失败的额外重试次数，默认 3（最多调用 4 次）；0 禁用，会产生额外费用
# MUSIC_AGENT_JSON_RETRIES=3
# MUSIC_AGENT_MINIMUM_CONFIDENCE=0.85
# MUSIC_AGENT_MINIMUM_SINGING_SECONDS=30
# MUSIC_AGENT_BOUNDARY_CONTEXT=20
# MUSIC_AGENT_MERGE_GAP=10
# MUSIC_AGENT_NETEASE_ENDPOINT=http://127.0.0.1:3000/audio/match
# MUSIC_AGENT_SKIP_NETEASE=false
# MUSIC_AGENT_SKIP_SHAZAM=false
# MUSIC_AGENT_NO_TITLE_MODEL=false
# 最终全场总结模型（独立于标题裁决开关，额外产生模型调用费用）
# MUSIC_AGENT_SUMMARY_MODEL=qwen3.8-flash
# WEBUI_OUTPUT_DIR=output
