# Google Gemini 官方接口（出点位、报幕识别与文本处理都走这里）
GEMINI_API_KEY=
# 需要代理时填写，必须带协议，如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080；留空直连
# GEMINI_PROXY=
# 可选：自定义接入地址，默认 https://generativelanguage.googleapis.com
# GEMINI_BASE_URL=
# 可选：覆盖音频模型，默认 gemini-4-hydrogen
# GEMINI_AUDIO_MODEL=

# 可选：后端处理参数，未设置时使用 CLI 默认值；CLI 显式参数优先
# 所有 CLI 可选参数均可用 MUSIC_AGENT_ + 大写下划线参数名覆盖
# MUSIC_AGENT_MINIMUM_CONFIDENCE=0.85
# MUSIC_AGENT_MINIMUM_SINGING_SECONDS=30
# MUSIC_AGENT_BOUNDARY_CONTEXT=20
# 网易云指纹直接请求上游，不需要另外启动服务
# MUSIC_AGENT_NETEASE_COOKIE=
# MUSIC_AGENT_SKIP_NETEASE=false
# MUSIC_AGENT_SKIP_SHAZAM=false
# MUSIC_AGENT_CANDIDATE_CONCURRENCY=3
# MUSIC_AGENT_MODEL_CONCURRENCY=3
# MUSIC_AGENT_RECOGNIZER_CONCURRENCY=3
# MUSIC_AGENT_MEDIA_CONCURRENCY=2
# WEBUI_DATA_DIR=data/webui
